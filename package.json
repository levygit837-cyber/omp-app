{
  "name": "omp-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "electron"
  ],
  "scripts": {
    "build:sidecar": "bun run --cwd packages/sidecar build",
    "dev": "bun run build:sidecar && bun run --cwd apps/desktop dev",
    "package": "bun run build:sidecar && bun run --cwd apps/desktop package",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check . && depcruise apps packages --config .dependency-cruiser.cjs",
    "format": "biome check --write .",
    "test": "bun test --pass-with-no-tests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "dependency-cruiser": "18.7.0",
    "typescript": "6.0.3"
  }
}
