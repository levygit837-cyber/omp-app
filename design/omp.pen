                              "fill": "#B29E93",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Timer em Geist Mono para os dígitos não dançarem; conta em segundos até 59s e depois 1m 04s. tok/s só aparece depois de 2 s, quando o número estabiliza.",
                              "lineHeight": 1.55,
                              "fontFamily": "Instrument Sans",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            },
