                                                  "name": "Paragraph",
                                                  "fill": "#F1E4DA",
                                                  "textGrowth": "fixed-width",
                                                  "width": "fill_container",
                                                  "content": "The test slept on a real 50 ms timer and raced the backoff under load. It now drives the supervisor with a fake clock, so the restart happens on a tick the test controls.",
                                                  "lineHeight": 1.55,
                                                  "fontFamily": "Instrument Sans",
                                                  "fontSize": 15.5,
                                                  "fontWeight": "normal"
