                                                  "name": "Causa",
                                                  "fill": "#B29E93",
                                                  "textGrowth": "fixed-width",
                                                  "width": "fill_container",
                                                  "content": "Another omp wrote agent.db with schema 7; omp-app ships omp 18.12.6, which reads schema 6. To keep your sessions safe, nothing here writes to ~/.omp until you update the app.",
                                                  "lineHeight": 1.5,
                                                  "fontFamily": "Instrument Sans",
                                                  "fontSize": 14,
                                                  "fontWeight": "normal"
                                                },
