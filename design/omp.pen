                        {
                          "type": "text",
                          "id": "IOSaE",
                          "name": "Item",
                          "fill": "#B29E93",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Uma explicação só, no topo do chat da primeira session aberta, entre duas réguas enxofre a 33 % (a forma da faixa de espera da 4c, sem as ações de aprovação). “Got it” a recolhe para sempre neste estado [S].",
                          "lineHeight": 1.5,
                          "fontFamily": "Instrument Sans",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
